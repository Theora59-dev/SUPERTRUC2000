{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SUPERTRUC 2000",
  "version": "0.1.0",
  "identifier": "com.supertruc2000.atelier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SUPERTRUC 2000 — Atelier de découpe 3D",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Découpez et préparez vos grands modèles 3D",
    "longDescription": "SUPERTRUC 2000 découpe les grands modèles 3D en pièces imprimables, ajoute des connecteurs, répare les maillages et exporte en STL, OBJ ou 3MF."
  }
}
